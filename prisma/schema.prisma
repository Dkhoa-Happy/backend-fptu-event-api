// schema.prisma

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  student
  admin
  staff
  event_organizer
}

enum UserStatus {
  PENDING
  APPROVED
  REJECTED
}

enum EventStatus {
  PENDING
  PUBLISHED
  CANCELED
}

enum TicketStatus {
  VALID
  USED
  CANCELLED
  EXPIRED
}

enum IncidentStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
}

enum IncidentSeverity {
  LOW
  MEDIUM
  HIGH
}

model User {
  id               Int        @id @default(autoincrement())
  userName         String     @unique @map("user_name")
  passwordHash     String?    @map("password_hash")
  googleId         String?    @unique @map("google_id")
  avatar           String?
  phoneNumber      String?    @map("phone_number")
  gender           Boolean?   @map("gender")
  address          String?
  firstName        String     @map("first_name")
  lastName         String     @map("last_name")
  studentCode      String?    @unique @map("student_code")
  email            String     @unique
  studentCardImage String?    @map("student_card_image")
  status           UserStatus @default(PENDING) @map("status")
  refreshTokenHash String?    @map("refresh_token_hash")
  createdAt        DateTime   @default(now()) @map("created_at")
  isActive         Boolean    @default(true) @map("is_active")
  roleName         UserRole   @map("role_name")

  // Quan hệ: Campus 1 mandatory to User
  campusId Int    @map("campus_id")
  campus   Campus @relation(fields: [campusId], references: [id])

  feedbacks Feedback[]

  // Quan hệ cũ
  hostedEvents Event[] @relation("HostEvents")

  // Quan hệ mới: User mua Tickets
  tickets Ticket[] @relation("UserTickets")

  // Quan hệ mới: User là Staff thực hiện Check-in
  // Quan hệ mới: User là Staff của Event (được mời làm check-in)
  eventStaffs EventStaff[]

  // Quan hệ: User báo cáo sự cố trước sự kiện
  incidents Incident[] @relation("IncidentReporter")

  // Quan hệ: User là Chủ nhiệm của Organizer
  ownedOrganizers Organizer[] @relation("OrganizerOwner")

  // Quan hệ: User có subscription OneSignal
  subscriptions UserSubscription[]

  @@map("users")
}

model Organizer {
  id           Int      @id @default(autoincrement())
  name         String
  description  String?
  contactEmail String?  @map("contact_email")
  logoUrl      String?  @map("logo_url")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt

  // Quan hệ: Campus 1 optional to Organizer
  campusId Int?    @map("campus_id")
  campus   Campus? @relation(fields: [campusId], references: [id])

  // Quan hệ: Chủ nhiệm (owner) của Organizer
  ownerId Int?  @map("owner_id")
  owner   User? @relation("OrganizerOwner", fields: [ownerId], references: [id])

  events Event[]

  @@map("organizers")
}

model Event {
  id                String      @id @default(uuid())
  title             String
  description       String?
  category          String?
  bannerUrl         String?     @map("banner_url")
  startTimeRegister DateTime    @map("start_time_register")
  endTimeRegister   DateTime    @map("end_time_register")
  startTime         DateTime    @map("start_time")
  endTime           DateTime    @map("end_time")
  status            EventStatus @default(PENDING)
  maxCapacity       Int         @map("max_capacity")
  registeredCount   Int         @default(0) @map("registered_count")
  /// Nếu true: sự kiện public toàn hệ thống (mọi campus đều thấy/join được)
  /// Nếu false: chỉ sinh viên thuộc campus của sự kiện mới thấy (dựa vào campus của venue)
  isGlobal          Boolean     @default(false) @map("is_global")
  createdAt         DateTime    @default(now()) @map("created_at")

  // Host và Organizer (Giữ nguyên)
  hostId      Int       @map("host_id")
  host        User      @relation("HostEvents", fields: [hostId], references: [id])
  organizerId Int       @map("organizer_id")
  organizer   Organizer @relation(fields: [organizerId], references: [id])

  // Quan hệ: Events -> Venues
  // Theo hình vẽ có ký hiệu tròn (o) nên quan hệ này là Optional (Event có thể chưa có Venue hoặc Online)
  venueId Int?   @map("venue_id")
  venue   Venue? @relation(fields: [venueId], references: [id])

  tickets Ticket[]

  // Quan hệ khác
  feedbacks     Feedback[]
  eventSpeakers EventSpeaker[]

  // Quan hệ mới: Staff được mời làm check-in cho Event
  eventStaffs EventStaff[]

  // Báo cáo sự cố trước sự kiện
  incidents Incident[]

  // Tổng kết attendance sau sự kiện
  summary EventSummary?

  // Notification logs
  notifications EventNotificationLog[]

  @@map("events")
}

model Feedback {
  id        Int      @id @default(autoincrement())
  rating    Int
  comment   String?
  createdAt DateTime @default(now()) @map("created_at")

  // Quan hệ: Many Feedbacks -> 1 Event
  eventId String @map("event_id")
  event   Event  @relation(fields: [eventId], references: [id])

  userId Int  @map("user_id")
  user   User @relation(fields: [userId], references: [id])

  @@map("feedbacks")
}

model EventSpeaker {
  id        Int     @id @default(autoincrement())
  topic     String?
  speakerId Int     @map("speaker_id")
  eventId   String  @map("event_id")

  speaker Speaker @relation(fields: [speakerId], references: [id])
  event   Event   @relation(fields: [eventId], references: [id]) // Đã xóa dòng duplicate

  @@map("event_speakers")
}

model Speaker {
  id            Int            @id @default(autoincrement())
  name          String
  bio           String?
  avatar        String?
  type          String
  company       String?
  createdAt     DateTime       @default(now()) @map("created_at")
  eventSpeakers EventSpeaker[]

  @@map("speakers")
}

model Venue {
  id          Int     @id @default(autoincrement())
  name        String
  location    String
  row         Int
  column      Int
  hasSeats    Boolean @map("has_seats")
  mapImageUrl String? @map("map_image_url")
  status      String

  // Quan hệ: Campus 1 mandatory to Venue (Sửa từ Int? thành Int)
  campusId Int    @map("campus_id")
  campus   Campus @relation(fields: [campusId], references: [id])

  events Event[]
  seats  Seat[]

  @@map("venues")
}

model Seat {
  id       Int     @id @default(autoincrement())
  rowLabel String  @map("row_label")
  colLabel Int     @map("col_label")
  seatType String  @map("seat_type")
  isActive Boolean @default(true) @map("is_active")
  isBooked Boolean @default(false) @map("is_booked")

  venueId Int   @map("venue_id")
  venue   Venue @relation(fields: [venueId], references: [id])

  // Quan hệ mới: Seat có thể được book bởi Ticket
  tickets Ticket[]

  @@map("seats")
}

model Campus {
  id       Int     @id @default(autoincrement())
  name     String  @unique
  code     String  @unique
  capacity Int?
  address  String?
  image    String?
  status   String

  // Quan hệ: 1 Campus -> Many Venues (Mandatory)
  venues Venue[]

  // Quan hệ: 1 Campus -> Many Users (Mandatory)
  users User[]

  // Quan hệ: 1 Campus -> Many Organizers (Optional)
  organizers Organizer[]

  @@map("campuses")
}

model Ticket {
  id          String       @id @default(uuid())
  qrCode      String       @unique @map("qr_code")
  status      TicketStatus @default(VALID)
  bookingDate DateTime     @default(now()) @map("booking_date")
  checkinTime DateTime?    @map("checkin_time")

  // Quan hệ: Tickets many mandatory to 1 Event
  eventId String @map("event_id")
  event   Event  @relation(fields: [eventId], references: [id])

  // Quan hệ: Tickets many mandatory to 1 User (Người mua)
  userId Int  @map("user_id")
  user   User @relation("UserTickets", fields: [userId], references: [id])

  // Quan hệ: Tickets 1 optional to many mandatory Seats (Một vé gắn với 1 ghế)
  seatId Int?  @map("seat_id")
  seat   Seat? @relation(fields: [seatId], references: [id])

  // Đảm bảo mỗi user chỉ có 1 ticket cho mỗi event
  @@unique([userId, eventId], map: "tickets_user_event_unique")
  // Đảm bảo mỗi (event, seat) chỉ có tối đa 1 Ticket
  @@unique([eventId, seatId], map: "tickets_event_seat_unique")
  @@index([qrCode])
  @@map("tickets")
}

// Bảng mới: Nhân sự sự kiện (Staff được mời làm check-in)
model EventStaff {
  id        Int      @id @default(autoincrement())
  createdAt DateTime @default(now()) @map("created_at")

  // FK: Staff này làm cho sự kiện nào?
  eventId String @map("event_id")
  event   Event  @relation(fields: [eventId], references: [id])

  // FK: Staff này là sinh viên nào?
  userId Int  @map("user_id")
  user   User @relation(fields: [userId], references: [id])

  // Đảm bảo mỗi user chỉ được add vào 1 event 1 lần
  @@unique([eventId, userId])
  @@map("event_staffs")
}

// Lưu subscription OneSignal của user để gửi thông báo đích danh
model UserSubscription {
  id             Int      @id @default(autoincrement())
  subscriptionId String   @unique @map("subscription_id")
  deviceId       String?  @map("device_id")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  // Quan hệ: User có subscription
  userId Int  @map("user_id")
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_subscriptions")
}

// Lưu log thông báo để tránh gửi trùng
model EventNotificationLog {
  id      Int      @id @default(autoincrement())
  eventId String   @map("event_id")
  type    String // "one_day" | "thirty_min"
  sentAt  DateTime @default(now()) @map("sent_at")

  event Event @relation(fields: [eventId], references: [id])

  @@unique([eventId, type], map: "event_notification_unique")
  @@map("event_notification_logs")
}

// Lưu tổng kết attendance sau khi sự kiện kết thúc
model EventSummary {
  id              Int      @id @default(autoincrement())
  eventId         String   @unique @map("event_id")
  totalRegistered Int
  totalAttended   Int
  totalNoShow     Int
  generatedAt     DateTime @default(now()) @map("generated_at")

  event Event @relation(fields: [eventId], references: [id])

  @@map("event_summaries")
}

// Báo cáo sự cố của Staff cho sự kiện
model Incident {
  id          Int              @id @default(autoincrement())
  title       String
  description String?
  severity    IncidentSeverity @default(MEDIUM)
  status      IncidentStatus   @default(OPEN)
  createdAt   DateTime         @default(now()) @map("created_at")
  updatedAt   DateTime         @updatedAt @map("updated_at")

  eventId String @map("event_id")
  event   Event  @relation(fields: [eventId], references: [id])

  reporterId Int  @map("reporter_id")
  reporter   User @relation("IncidentReporter", fields: [reporterId], references: [id])

  @@index([eventId])
  @@index([reporterId])
  @@map("incidents")
}
